#!/usr/bin/env python3
"""Does a process started through scope.wrap survive a restart of the unit that started it?

A driver runs in a transient user unit that stands in for agentview.service (a
plain service, KillMode=control-group). It starts what the server starts, through
the real launch helpers, with every leaf faked:

  jump.open_tab            a window for a conversation in the closed list
  snapshot._start_gui      a window that restore has to start
  snapshot._tmux_argv      the tmux server, from `tmux new-session -d`

It writes down each process, its cgroup and its scope. The harness then restarts
the unit and looks at which are still alive. A second run with AGENTVIEW_SCOPE=off
is the control: what it started in the unit's cgroup must be gone, and so must the
tmux pane, or the first run proves nothing.

What this is not: no server.py, no port, no HTTP, no restore. The call sites
inside `restore` and `launch` are pinned by tests/test_scope.py against fake
leaves; this proves the scope, not that those sites are reached.

What it cannot reach, and why:
  tmux      the driver's PATH holds only the box: shims for tmux, wezterm, pgrep
            and claude, and links to systemd-run, systemctl, sleep and true. No
            real tmux, wezterm or claude is on it. The tmux shim runs the real
            binary with `-f /dev/null -S <private socket>` and no $TMUX, so the
            socket is never the default and no tmux.conf is read. A read-only
            preflight, in the harness and again in the unit, aborts unless tmux
            resolves to the shim and names the private socket; a second one runs
            what scope.wrap wraps and aborts unless wezterm and tmux resolve to
            the shims and it really ran in a scope (in the unit's cgroup, for
            the control).
  WezTerm   `wezterm` is a shim that logs and runs `sleep`. The unit's
            environment holds no WEZTERM_*, no DISPLAY, no SSH_AUTH_SOCK.
  the unit  every name is `avsc-<random run id>-<mode>`; the box directory, made
            with a plain mkdir that fails if it exists, is what makes a run id
            this invocation's. Nothing is stopped or killed unless that mkdir
            succeeded, and a unit is only restarted or stopped while its
            description and InvocationID are still this run's. agentview.service
            is never named.
  anything  nothing is signalled by pid. Cleanup stops this run's unit, kills the
            private tmux server by its socket, and stops a scope only if, when
            looked at again just before, every process in it carries this run's
            marker. SIGINT and SIGTERM only leave a note; the run stops at its
            next check and always cleans up.
The only real things it uses: the user's systemd manager (the point of the
check) and read-only listings of the real tmux and WezTerm before and after.

    scripts/scope-check    exit 0: scoped run kept everything, control lost it,
                           nothing left behind, real desktop unchanged
                           1 an expectation failed; 2 aborted or left something
                           behind; 3 the real tmux or WezTerm listing differs or
                           could not be made
"""
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
SCOPED = ("tmux server", "window via jump.open_tab", "window via snapshot._start_gui")
PANE = "tmux pane"
TOOLS = ("systemd-run", "systemctl", "sleep", "true")     # the only real binaries the driver finds by name


class Abort(Exception):
    """The check cannot run, or stopped before it could say anything."""


# ----------------------------------------------------------------- the box

def fakes(box, real_tmux):
    q = shlex.quote
    return {
        "tmux": f'#!/bin/sh\nunset TMUX\nexec {q(real_tmux)} -f /dev/null -S {q(str(box / "t.sock"))} "$@"\n',
        "wezterm": ('#!/bin/bash\n[ "$1" = start ] && { echo "$$ $*" >> '
                    + q(str(box / "windows")) + '; exec sleep 3600; }\nexit 0\n'),
        "pgrep": "#!/bin/sh\nexit 1\n",
        "claude": "#!/bin/sh\nexit 0\n",
    }


def check_socket_path(box):
    if len(str(box / "t.sock")) > 100:
        raise Abort(f"the private socket path is too long for a unix socket: {box / 't.sock'}")


def fill_box(box, real_tmux):
    for sub in ("bin", "home/.config", "state", "tmux", "cfg"):
        (box / sub).mkdir(parents=True)
    for name, body in fakes(box, real_tmux).items():
        path = box / "bin" / name
        path.write_text(body)
        path.chmod(0o755)
    for tool in TOOLS:
        target = shutil.which(tool)
        if not target:
            raise Abort(f"no {tool} on PATH")
        (box / "bin" / tool).symlink_to(os.path.abspath(target))


def env_for(box, mode, run):
    """The whole environment of the driver: nothing is inherited from the user
    manager or from this shell. XDG_RUNTIME_DIR and the bus address stay, since
    talking to the real user manager is what is being tested."""
    env = {"PATH": f"{box}/bin", "HOME": f"{box}/home",
           "XDG_CONFIG_HOME": f"{box}/home/.config", "XDG_STATE_HOME": f"{box}/state",
           "XDG_RUNTIME_DIR": str(RUNTIME), "TMUX_TMPDIR": f"{box}/tmux",
           "CLAUDE_CONFIG_DIR": f"{box}/cfg", "AVSC_RUN": run,
           "AGENTVIEW_SCOPE": "on" if mode == "on" else "off"}
    if os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        env["DBUS_SESSION_BUS_ADDRESS"] = os.environ["DBUS_SESSION_BUS_ADDRESS"]
    return env


def driver_command(box, mode, run):
    """What the unit runs: the driver, in exactly env_for's environment and no other."""
    return (["/usr/bin/env", "-i"] + [f"{k}={v}" for k, v in env_for(box, mode, run).items()]
            + [sys.executable, str(Path(__file__).resolve()), "--driver", str(box), mode])


def preflight(box, env):
    """Read-only. With this environment, is `tmux` the shim, and does it look
    for its server at the private socket? `list-sessions` never starts a server.
    tmux falls back to the real socket in more than one silent way (a missing
    TMUX_TMPDIR, $TMUX), and a check that goes on to start a session has then
    started it on the owner's server."""
    shim = str(box / "bin" / "tmux")
    found = shutil.which("tmux", path=env["PATH"])
    if found != shim:
        raise Abort(f"tmux resolves to {found}, not the shim {shim}")
    res = subprocess.run([shim, "list-sessions"], capture_output=True, text=True, timeout=10, env=env)
    if res.returncode == 0 or str(box / "t.sock") not in res.stderr:
        raise Abort(f"tmux does not report the private socket (exit {res.returncode}): {res.stderr.strip()[:200]!r}")


def probe_scope(box, run, mode):
    """Before anything is launched: what a command sees when scope.wrap wraps
    it. It must find the shims, not real binaries, carry the marker, and be in
    a scope (scoped run) or in the unit's own cgroup (control). scope.wrap
    fails open, so without the last check a probe could pass without a scope."""
    import scope
    show_path = ('read -r cg < /proc/self/cgroup; '
                 'printf "%s\\n" "$(command -v wezterm)" "$(command -v tmux)" "$AVSC_RUN" "$cg"')
    res = subprocess.run(scope.wrap(["/bin/sh", "-c", show_path], "preflight"),
                         capture_output=True, text=True, timeout=20)
    seen = res.stdout.split()
    if res.returncode != 0 or seen[:3] != [str(box / "bin" / "wezterm"), str(box / "bin" / "tmux"), run]:
        raise Abort(f"a wrapped command finds {seen[:2]} (exit {res.returncode}), not the shims in {box}/bin")
    where = seen[3] if len(seen) > 3 else ""
    if not where.endswith(".scope" if mode == "on" else ".service"):
        raise Abort(f"the probe ran in {where!r}, not in {'a scope' if mode == 'on' else 'the unit'}")


# --------------------------------------------------------------- processes

def parse_stat(raw):
    """(state, start time) from the text of /proc/<pid>/stat. The name in
    parentheses can hold spaces and parentheses, so split after the last one."""
    fields = raw.rsplit(")", 1)[1].split()
    return fields[0], fields[19]


def stat(pid):
    try:
        return parse_stat(Path(f"/proc/{pid}/stat").read_text())
    except (OSError, IndexError):
        return None


def alive(pid, start):
    st = stat(pid)
    return bool(st) and st[1] == start and st[0] != "Z"


def cgroup(pid):
    try:
        for line in Path(f"/proc/{pid}/cgroup").read_text().splitlines():
            if line.startswith("0::"):
                return line[3:]
    except OSError:
        pass
    return ""


def marked(run, live_only=True):
    """Pids whose environment carries this run's marker."""
    tag = b"AVSC_RUN=" + run.encode()
    found = set()
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            env = (entry / "environ").read_bytes().split(b"\0")
        except OSError:
            continue
        if tag in env and (not live_only or (stat(entry.name) or ("Z",))[0] != "Z"):
            found.add(int(entry.name))
    return found


# ------------------------------------------------------------------ systemd

def ctl(*args, timeout=30):
    return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=timeout)


def show(unit, *props):
    res = ctl("show", *[f"--property={p}" for p in props], unit)
    return dict(line.partition("=")[::2] for line in res.stdout.splitlines() if "=" in line)


class Unit:
    """The transient service this run makes. Named after the run, and only
    restarted or stopped once its start was attempted and while it is still
    this one."""

    def __init__(self, run, mode):
        self.name = f"avsc-{run}-{mode}.service"
        self.desc = f"scope-check {run} {mode}"
        self.attempted = False
        self.inv = ""

    def mine(self):
        """Never on the description alone: the InvocationID of the invocation
        this run started must be known and still current."""
        if not self.attempted or not self.inv:
            return False
        p = show(self.name, "Description", "InvocationID")
        return p.get("Description") == self.desc and p.get("InvocationID") == self.inv

    def start(self, cmd):
        self.attempted = True           # from here a unit of this name may exist, even if systemd-run says otherwise
        res = subprocess.run(["systemd-run", "--user", f"--unit={self.name}",
                              f"--description={self.desc}", "--property=KillMode=control-group", "--"] + cmd,
                             capture_output=True, text=True, timeout=30)
        if res.returncode != 0:
            raise Abort(f"systemd-run exited {res.returncode}: {res.stderr.strip()[:200]}")
        # systemd-run says the invocation ID of what it just created; asking afterwards is the fallback.
        said = re.search(r"invocation ID: ([0-9a-f]{32})", res.stderr)
        self.inv = said.group(1) if said else show(self.name, "InvocationID").get("InvocationID", "")
        if not self.inv:
            raise Abort(f"the unit has no InvocationID, so it will not be stopped by this script: "
                        f"systemctl --user stop {self.name}")

    def restart(self):
        if not self.mine():
            raise Abort("the unit is not the one this run made")
        old = self.inv
        res = ctl("restart", self.name, timeout=120)
        p = show(self.name, "Description", "ActiveState", "InvocationID")
        if p.get("Description") == self.desc and p.get("InvocationID"):
            self.inv = p["InvocationID"]    # still this unit, whatever the restart did: cleanup must reach it
        if res.returncode != 0 or p.get("ActiveState") != "active" or self.inv == old:
            raise Abort(f"restart: exit {res.returncode}, {p}, {res.stderr.strip()[:200]}")

    def stop(self):
        if self.mine():
            ctl("stop", self.name, timeout=120)
            ctl("reset-failed", self.name)


INTERRUPTED = []


def on_signal(signum, _frame):
    """SIGINT and SIGTERM only leave a note. The run stops at its next check,
    so no signal can arrive in the middle of cleanup and skip a step."""
    INTERRUPTED.append(signum)


def check_interrupt():
    if INTERRUPTED:
        raise Abort(f"interrupted (signal {INTERRUPTED[0]})")


def wait_for(path, unit, seconds=40):
    end = time.time() + seconds
    while time.time() < end:
        check_interrupt()
        if path.exists():
            return
        if show(unit.name, "ActiveState").get("ActiveState") in ("failed", "inactive"):
            tail = subprocess.run(["journalctl", "--user", "-u", unit.name, "-n", "20", "--no-pager", "-o", "cat"],
                                  capture_output=True, text=True, timeout=20).stdout
            raise Abort(f"the driver ended before it finished:\n{tail}")
        time.sleep(0.2)
    raise Abort(f"the driver did not finish in {seconds} s")


# ------------------------------------------------------------------- driver

def describe(role, pid):
    st = stat(pid)
    if not st:
        raise Abort(f"{role}: pid {pid} is not running")
    cg = cgroup(pid)
    row = {"role": role, "pid": pid, "start": st[1], "cgroup": cg, "scope": "", "oom": "", "desc": ""}
    if cg.endswith(".scope"):
        name = cg.rsplit("/", 1)[1]
        p = show(name, "Description", "OOMPolicy")
        row.update(scope=name, oom=p.get("OOMPolicy", ""), desc=p.get("Description", ""))
    return row


def window_pid(box, tag, seconds=10):
    end = time.time() + seconds
    while time.time() < end:
        try:
            lines = (box / "windows").read_text().splitlines()
        except OSError:
            lines = []
        for line in lines:
            if line.split()[-1:] == [tag]:
                return int(line.split()[0])
        time.sleep(0.1)
    raise Abort(f"the fake wezterm did not log a window tagged {tag}")


def idle():
    while True:
        time.sleep(3600)


def driver(box, mode):
    """Runs inside the unit. Starts things through the real launch helpers,
    records them, then idles as the unit's main process."""
    run = os.environ["AVSC_RUN"]
    try:
        os.close(os.open(box / "started", os.O_CREAT | os.O_EXCL | os.O_WRONLY))
    except FileExistsError:             # the restarted unit runs this again; it only has to be there
        idle()
    preflight(box, os.environ)
    sys.path.insert(0, str(REPO))
    probe_scope(box, run, mode)
    from unittest import mock
    import jump
    import snapshot
    rows = []

    def note(role, pid):
        rows.append(describe(role, pid))
        (box / "record.json").write_text(json.dumps(rows))

    with mock.patch.object(jump, "_pid_of_command", return_value=None):
        if not jump.open_tab(["claude", "--resume", "w1"], cwd=str(box))["ok"]:
            raise Abort("jump.open_tab did not start a window")
    note("window via jump.open_tab", window_pid(box, "w1"))
    with mock.patch.object(snapshot, "_gui_running", return_value=True), \
            mock.patch.object(snapshot, "wez_panes", return_value=[{"window_id": 1}]):
        snapshot._start_gui(str(box), ["claude", "--resume", "w2"], None)
    note("window via snapshot._start_gui", window_pid(box, "w2"))
    made = snapshot._run(snapshot._tmux_argv(["tmux", "new-session", "-d", "-s", f"avsc-{run}", "sleep 3600"]))
    if not made or made.returncode != 0:
        raise Abort(f"tmux new-session failed: {made.stderr.strip()[:200] if made else 'did not run'}")
    server = snapshot._run(["tmux", "display-message", "-p", "#{pid}"])
    panes = snapshot._run(["tmux", "list-panes", "-a", "-F", "#{pane_pid}"])
    if not (server and panes and server.stdout.strip().isdigit() and panes.stdout.split()):
        raise Abort("could not read the tmux server and pane pids")
    note("tmux server", int(server.stdout))
    note(PANE, int(panes.stdout.split()[0]))
    (box / "ready").write_text("")
    idle()


# ------------------------------------------------------------------ judging

def judge(mode, rows, unit_cg, is_alive):
    """What is wrong with this run, as strings; none means it showed what it
    should. `is_alive` maps role to whether the process outlived the restart."""
    problems = [f"{role}: not recorded" for role in SCOPED + (PANE,) if role not in {r["role"] for r in rows}]
    for r in rows:
        role = r["role"]
        inside = r["cgroup"] == unit_cg or r["cgroup"].startswith(unit_cg + "/")
        if mode == "on":
            if role in SCOPED:
                if inside or not r["scope"] or not r["desc"].startswith("agentview: "):
                    problems.append(f"{role}: not in a scope that scope.wrap made ({r['cgroup']}, {r['desc']!r})")
                if r["oom"] != "continue":
                    problems.append(f"{role}: OOMPolicy is {r['oom']!r}, not 'continue'")
            if not is_alive[role]:
                problems.append(f"{role}: gone after the restart")
        elif role in SCOPED:
            if not inside:
                problems.append(f"{role}: was not in the unit's cgroup, so the control proves nothing")
            if is_alive[role]:
                problems.append(f"{role}: survived the restart with no scope")
        elif is_alive[role]:
            problems.append(f"{role}: outlived its tmux server, so the session was not lost in the control")
    return problems


# ------------------------------------------------------------------ cleanup

def carries(pid, run):
    try:
        return b"AVSC_RUN=" + run.encode() in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
    except OSError:
        return False


def live_members(cg):
    try:
        members = [int(x) for x in Path(f"/sys/fs/cgroup{cg}/cgroup.procs").read_text().split()]
    except OSError:
        return []
    return [m for m in members if (stat(m) or ("Z",))[0] != "Z"]


def scope_invocation(name, cg, run):
    """The InvocationID of a scope that scope.wrap made for this run, or ''.
    Judged from the scope's members as they are now: at least one, and every one
    carries this run's marker. A pid from an earlier list decides nothing, so a
    reused pid cannot bring in a scope that is not this run's."""
    members = live_members(cg)
    if not members or not all(carries(m, run) for m in members):
        return ""
    p = show(name, "Description", "InvocationID")
    return p.get("InvocationID", "") if p.get("Description", "").startswith("agentview: ") else ""


def stop_our_scopes(run):
    """Stop the scopes scope.wrap made for this run. The pids of the marked
    processes only suggest which scopes to look at; each one is judged by
    scope_invocation, twice, the second time just before the stop."""
    candidates = {}
    for pid in marked(run):
        cg = cgroup(pid)
        if cg.endswith(".scope"):
            candidates[cg.rsplit("/", 1)[1]] = cg
    for name, cg in candidates.items():
        inv = scope_invocation(name, cg, run)
        if inv and scope_invocation(name, cg, run) == inv:
            ctl("stop", name)


def cleanup(run, box, unit, real_tmux, made):
    """Stops what this run started and returns the pids that still carry its
    marker. Nothing is touched unless this invocation made the box."""
    if not made:
        return set()
    steps = (unit.stop,
             lambda: subprocess.run([real_tmux, "-f", "/dev/null", "-S", str(box / "t.sock"), "kill-server"],
                                    capture_output=True, timeout=10),
             lambda: stop_our_scopes(run))
    for step in steps:                  # each one on its own: a failure must not skip the rest
        try:
            step()
        except Exception as exc:
            print(f"  cleanup step failed: {type(exc).__name__}: {exc}")
    end = time.time() + 10
    while marked(run) and time.time() < end:
        time.sleep(0.3)
    left = marked(run)
    if not left and box.exists():
        shutil.rmtree(box)
    return left


# ---------------------------------------------------------------- the harness

def desktop(real_tmux):
    """Read-only listings of the real tmux server and WezTerm; None for one
    that could not be made."""
    tm = subprocess.run([real_tmux, "list-sessions", "-F", "#{session_id} #{session_name}"],
                        capture_output=True, text=True, timeout=10)
    sessions = (sorted(tm.stdout.splitlines()) if tm.returncode == 0
                else [] if "no server running" in tm.stderr else None)
    try:
        wz = subprocess.run(["wezterm", "cli", "--no-auto-start", "list", "--format", "json"],
                            capture_output=True, text=True, timeout=10)
        windows = (sorted({(p["window_id"], p["tab_id"]) for p in json.loads(wz.stdout)})
                   if wz.returncode == 0 else None)
    except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError):
        windows = None
    return {"tmux sessions": sessions, "wezterm windows and tabs": windows}


def compare(before, after, run):
    """Says what changed on the real desktop. 0 if nothing did, 3 if something
    did or if a listing could not be made (unchanged cannot then be said)."""
    unlisted = [k for k in before if before[k] is None or after[k] is None]
    for key in unlisted:
        print(f"  {key}: could not be listed, so 'unchanged' cannot be said")
    changed = [k for k in before if k not in unlisted and before[k] != after[k]]
    for key in changed:
        gone = [x for x in before[key] if x not in after[key]]
        new = [x for x in after[key] if x not in before[key]]
        print(f"  {key} differ: gone {gone}, new {new}")
    if not unlisted and not changed:
        print("  tmux sessions and WezTerm windows: exactly as before")
        return 0
    ours = [s for s in after["tmux sessions"] or [] if f" avsc-{run}" in s]
    print("  " + (f"sessions of this run on the real server: {ours}" if ours
                  else f"none of the sessions carries this run's name (avsc-{run})"))
    return 3


def table(rows, is_alive):
    for r in rows:
        where = f"{r['scope']} ({r['desc']}, OOMPolicy={r['oom']})" if r["scope"] else r["cgroup"].rsplit("/", 1)[-1]
        print(f"  {r['role']:32} pid {r['pid']:<8} {where:70} {'alive' if is_alive[r['role']] else 'gone'} after the restart")


def exercise(run, mode, real_tmux):
    print(f"\n== {'scoped' if mode == 'on' else 'control, AGENTVIEW_SCOPE=off'}")
    box, unit, code, made = RUNTIME / f"avsc-{run}-{mode}", Unit(run, mode), 0, False
    try:
        check_socket_path(box)
        box.mkdir(mode=0o700)           # raises if it exists: then nothing here is this run's
        made = True
        fill_box(box, real_tmux)
        preflight(box, env_for(box, mode, run))
        check_interrupt()
        unit.start(driver_command(box, mode, run))
        wait_for(box / "ready", unit)
        rows = json.loads((box / "record.json").read_text())
        unit_cg = show(unit.name, "ControlGroup").get("ControlGroup", "")
        if not unit_cg:
            raise Abort("the unit has no ControlGroup")
        check_interrupt()
        unit.restart()
        time.sleep(2)
        check_interrupt()
        is_alive = {r["role"]: alive(r["pid"], r["start"]) for r in rows}
        table(rows, is_alive)
        problems = judge(mode, rows, unit_cg, is_alive)
        for p in problems:
            print(f"  FAIL {p}")
        code = 1 if problems else 0
    except Exception as exc:
        print(f"  ABORTED: {type(exc).__name__}: {exc}")
        code = 2
    finally:
        try:
            left = cleanup(run, box, unit, real_tmux, made)
        except Exception as exc:
            print(f"  cleanup failed: {type(exc).__name__}: {exc}")
            left = marked(run) or {0}
    if left:
        print(f"  LEFT BEHIND, marker AVSC_RUN={run}, box kept at {box}, unit {unit.name}: pids {sorted(left)}")
        code = 2
    return code


def main():
    if sys.argv[1:2] == ["--driver"]:
        return driver(Path(sys.argv[2]), sys.argv[3])
    found = shutil.which("tmux")
    if not found:
        raise SystemExit("no tmux on PATH")
    real_tmux = os.path.abspath(found)
    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)
    run = secrets.token_hex(4)
    print(f"run {run}")
    before = desktop(real_tmux)
    code = 2
    try:
        code = exercise(run, "on", real_tmux)
        if code == 2 or INTERRUPTED:
            print("\n== control: not run, the scoped run aborted, was interrupted or left something behind")
        else:
            code = max(code, exercise(run, "off", real_tmux))
    finally:
        print("\n== the real desktop")
        verdict = compare(before, desktop(real_tmux), run)
    code = max(code, verdict, 2 if INTERRUPTED else 0)
    print(f"\n{'PASS' if code == 0 else 'NOT PASS'} (exit {code})")
    return code


if __name__ == "__main__":
    sys.exit(main())
