#!/usr/bin/env python3
"""Hand a pull request to the merge desk, ask what became of it, take it back. Run by the session itself.

    desk ready OWNER/REPO N --what "what it does" --rec merge|wait|dont [--why "the evidence"] [--after N] [--by NAME]
    desk status [OWNER/REPO N]
    desk withdraw OWNER/REPO N
    desk page [--no-browser]

`ready` pins the PR's head as it is now; handing the same PR over again replaces the item and
re-pins. See desk.py.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
import desk

if __name__ == "__main__":
    sys.exit(desk.main())
